{
  "name": "dao-den-long",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Đảo Đèn Lồng — 3D Game (AI SDLC Lab v1.0.0)",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "start": "node src/run.js",
    "headless": "node src/headless.js",
    "bench": "node src/bench.js --seed 42 --duration 30 --out bench.json",
    "soak": "node --expose-gc src/soak.js --seed 7 --nights 10 --out soak.json",
    "test:unit": "node --test tests/sim.test.js",
    "test:scenarios": "node tests/run-scenarios.js",
    "test": "npm run test:unit && npm run test:scenarios"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "vite": "^6.0.7"
  }
}
